{
  "name": "@hillman95/passport-scanner",
  "version": "0.1.0",
  "description": "Local browser passport OCR with Latin/Cyrillic fields, MRZ checks and HEIC decoding",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hillman95/passport-scanner.git"
  },
  "homepage": "https://github.com/Hillman95/passport-scanner#readme",
  "bugs": {
    "url": "https://github.com/Hillman95/passport-scanner/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "scripts/prepare-assets.mjs",
    "scripts/heif-worker.js",
    "vendor/mrz",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./detail": {
      "types": "./dist/detail.d.ts",
      "import": "./dist/detail.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./recognize": {
      "types": "./dist/recognize.d.ts",
      "import": "./dist/recognize.js"
    },
    "./heif": {
      "types": "./dist/heif.d.ts",
      "import": "./dist/heif.js"
    },
    "./prepare-assets": "./scripts/prepare-assets.mjs"
  },
  "bin": {
    "passport-scanner-assets": "scripts/prepare-assets.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts examples/*.js --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit:release",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:release": "node scripts/audit-release.mjs && npm run audit:licenses",
    "assets": "node scripts/prepare-assets.mjs examples/ocr",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "libheif-js": "1.23.5",
    "mrz": "5.0.2",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
